 Do $SYSTEM.OBJ.Load("/opt/irisapp/Installer.cls", "ck")
 Set sc = ##class(App.Installer).setup()

 ZN "IRISAPP"
 Do $SYSTEM.OBJ.Load("/opt/irisapp/App.PEXSetup.cls", "ck")
 Set sc = ##class(App.PEXSetup).ConfigureAtBuild()
 Do ##class(Ens.Director).SetAutoStart("Crypto.CryptoProduction")

 ZN "%SYS"
 Do ##class(Security.Users).UnExpireUserPasswords("*")

halt
